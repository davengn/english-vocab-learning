{
  "name": "english-learning-os-v1",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Personal English Vocabulary & Grammar Learning OS for Vietnamese Learners (Zero-AI V1)",
  "scripts": {
    "dev": "concurrently -n API,WEB -c cyan,green \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx src/server/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx src/server/db/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.15",
    "@hono/node-server": "^1.14.1",
    "@tanstack/react-query": "^5.74.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.41.0",
    "exceljs": "^4.4.0",
    "hono": "^4.7.7",
    "lucide-react": "^0.488.0",
    "papaparse": "^5.5.2",
    "pg": "^8.14.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.5.0",
    "tailwind-merge": "^3.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/node": "^22.14.1",
    "@types/papaparse": "^5.3.15",
    "@types/pg": "^8.11.13",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.30.6",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.4.6",
    "vitest": "^3.1.2"
  }
}
