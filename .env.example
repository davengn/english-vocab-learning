# Optional external PostgreSQL connection string.
# Leave unset to use zero-config embedded PostgreSQL (PGlite persisted at ./data/pgdata).
# DATABASE_URL=postgresql://learner:learner_password@localhost:5432/english_learning_os

PORT=3001
DATA_DIR=./data/pgdata

# Authentication settings
# Set a strong random secret in production (Vercel / Netlify Environment Variables) to sign HttpOnly session cookies.
# AUTH_SECRET=replace-with-a-long-random-hex-secret
# Optional overrides for login account (default username is mywife with pre-hashed password in source):
# AUTH_USERNAME=mywife
# AUTH_PASSWORD_HASH=scrypt:<saltHex>:<hashHex>
